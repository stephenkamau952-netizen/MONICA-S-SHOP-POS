{
  "name": "monica-shop-pos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "worker"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w @shop/pos",
    "dev:worker": "wrangler dev",
    "build": "npm run build -w @shop/pos",
    "typecheck": "tsc -p packages/shared && tsc -p worker && tsc -p apps/pos && tsc -p supabase/tests",
    "test": "vitest run",
    "test:db": "vitest run supabase/tests",
    "check:deploy": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npm run build && wrangler deploy",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "@electric-sql/pglite": "0.5.17",
    "@types/node": "24.19.2",
    "supabase": "3.2.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
